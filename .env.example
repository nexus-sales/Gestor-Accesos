# Cadena de conexión a tu PostgreSQL (Dokploy, Railway, Supabase direct, etc.)
DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_db

# Secreto para firmar los JWT de sesión — mínimo 32 caracteres aleatorios
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# Puerto en el que escucha el servidor (por defecto 3000)
PORT=3000

# Entorno: "development" desactiva la cookie Secure para HTTP local
NODE_ENV=development
